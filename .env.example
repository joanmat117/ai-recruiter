# ===========================================
# AI RECRUITER - Environment Variables
# ===========================================
# Copia este archivo a .env y completa los valores
# cp .env.example .env
# ===========================================

# -------------------------------------------
# APP GENERAL
# -------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------
# DATABASE (PostgreSQL + pgvector)
# -------------------------------------------
# Lo levanta docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_recruiter?schema=public

# -------------------------------------------
# REDIS (BullMQ Queues)
# -------------------------------------------
# Lo levanta docker-compose.yml
REDIS_HOST=localhost
REDIS_PORT=6379

# -------------------------------------------
# S3 STORAGE (Filebase / AWS S3 / MinIO)
# -------------------------------------------
# ⚠️ SERVICIO EXTERNO - NO lo levanta docker-compose
# Necesitas una cuenta en: Filebase, AWS S3, MinIO, Cloudflare R2, etc.
S3_ENDPOINT=https://s3.filebase.com
S3_ACCESS_KEY=tu_access_key_aqui
S3_SECRET_KEY=tu_secret_key_aqui

# -------------------------------------------
# LLM PROVIDER (elige UNO)
# -------------------------------------------
# ⚠️ SERVICIO EXTERNO - NO lo levanta docker-compose
LLM_PROVIDER=openai          # openai | openrouter | gemini

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- OpenRouter (alternativa) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3-opus
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Gemini (alternativa) ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-pro

# -------------------------------------------
# SCORING POLICY (opcional - tienen defaults)
# -------------------------------------------
SCORING_WEIGHT_SKILLS=0.5
SCORING_WEIGHT_EXPERIENCE=0.3
SCORING_WEIGHT_EDUCATION=0.2
SCORING_THRESHOLD_ADVANCE=85
SCORING_THRESHOLD_REVIEW=50
SCORING_THRESHOLD_REJECT=0

# -------------------------------------------
# IP WHITELIST (opcional)
# -------------------------------------------
# Archivo JSON con IPs permitidas para acceder a la API
WHITELIST_FILE_PATH=src/data/ip-whitelist.json