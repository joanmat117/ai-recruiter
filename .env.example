# ===========================================
# AI RECRUITER - Environment Variables
# ===========================================
# Copia este archivo a .env y completa los valores
# cp .env.example .env
# ===========================================

# -------------------------------------------
# APP GENERAL
# -------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------
# DATABASE (PostgreSQL + pgvector)
# -------------------------------------------
# docker-compose levanta postgres en puerto 5432
# Para docker-compose: postgresql://postgres:postgres@postgres:5432/ai_recruiter?schema=public
# Para local: postgresql://postgres:postgres@localhost:5432/ai_recruiter?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_recruiter?schema=public

# -------------------------------------------
# REDIS (BullMQ Queues)
# -------------------------------------------
# docker-compose levanta redis en puerto 6379
REDIS_HOST=localhost
REDIS_PORT=6379

# -------------------------------------------
# S3 STORAGE - RUSTFS (Local via docker-compose)
# -------------------------------------------
# docker-compose levanta RustFS en puerto 9000
# Para docker-compose: http://rustfs:9000
# Para local (fuera de docker): http://localhost:9000
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# -------------------------------------------
# S3 STORAGE - EXTERNO (Filebase / AWS / MinIO / Cloudflare R2)
# -------------------------------------------
# Descomenta y configura si NO usas RustFS local
# S3_ENDPOINT=https://s3.filebase.com
# S3_ACCESS_KEY=tu_access_key_aqui
# S3_SECRET_KEY=tu_secret_key_aqui

# -------------------------------------------
# LLM PROVIDER (elige UNO)
# -------------------------------------------
# ⚠️ SERVICIO EXTERNO - Necesitas API key
LLM_PROVIDER=openai          # openai | openrouter | gemini

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- OpenRouter (alternativa) ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-3-opus
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Gemini (alternativa) ---
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-pro

# -------------------------------------------
# SCORING POLICY (opcional - tienen defaults)
# -------------------------------------------
SCORING_WEIGHT_SKILLS=0.5
SCORING_WEIGHT_EXPERIENCE=0.3
SCORING_WEIGHT_EDUCATION=0.2
SCORING_THRESHOLD_ADVANCE=85
SCORING_THRESHOLD_REVIEW=50
SCORING_THRESHOLD_REJECT=0

# -------------------------------------------
# IP WHITELIST (opcional)
# -------------------------------------------
# Archivo JSON con IPs permitidas para acceder a la API
WHITELIST_FILE_PATH=src/data/ip-whitelist.json